# ─────────────────────────────────────────────────────────────────────────────
# AI Job Matcher — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: "ollama", "gemini", "openai", "azure", "groq"
LLM_PROVIDER=ollama

# ── Local Ollama Settings ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:latest          # or qwen2.5-coder:3b

# ── Google Gemini (optional if using local Ollama) ────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Azure AI / Azure OpenAI (optional) ───────────────────────────────────────
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=phi-4-mini-instruct
AZURE_AI_API_VERSION=2024-05-01-preview

# ── Groq (optional) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Job source API keys (optional — public board API requires no key for job listings)
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# ── App settings ─────────────────────────────────────────────────────────────
APP_ENV=development               # development | production
LOG_LEVEL=INFO
MAX_JOBS_TO_FETCH=100
TOP_MATCHES_TO_SHOW=10

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/jobs.db

# ── Sentence Transformer model ────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
